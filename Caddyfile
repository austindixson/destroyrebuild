{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:3000} {
	log {
		format json
	}

	handle /health {
		respond 200
	}

	# York trainer chat. The API process runs on the captain's Mac.
	# YORK_API_UPSTREAM is the Tailscale Funnel URL. An unset value dials a
	# closed port, and handle_errors returns the honest unavailable sentence.
	# The proxy secret is added here. The browser cannot supply it.
	# X-York-Client-IP is the edge client, not a header the browser sent.
	handle /api/york/* {
		reverse_proxy {$YORK_API_UPSTREAM:127.0.0.1:9} {
			header_up X-York-Proxy-Secret {env.YORK_PROXY_SECRET}
			header_up X-York-Client-IP {remote_host}
			header_up -X-Real-IP
			header_up -X-Forwarded-For
			transport http {
				dial_timeout 5s
				response_header_timeout 110s
			}
		}
	}

	handle_errors {
		@york path /api/york/*
		handle @york {
			header Content-Type "application/json; charset=utf-8"
			respond "{\"status\":\"unavailable\",\"answer\":\"The AI chat is not available now.\"}" 200
		}
	}

	# Exact path only. /york-chiller/* is the trainer app.
	handle /york-chiller {
		redir * /york-chiller/ 308
	}

	handle /york-chiller/* {
		root * dist

		# Vite fingerprints JS/CSS under assets/. The GLB and icon are unhashed.
		@hashed path /york-chiller/assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# One path segment: /york-chiller/*.glb does not match models/ymc2.glb.
		@glb path /york-chiller/models/*.glb
		header @glb {
			Content-Type "model/gltf-binary"
			Cache-Control "public, max-age=86400"
			defer
		}

		@icon path /york-chiller/icon.svg
		header @icon Cache-Control "public, max-age=86400"

		# HTML entry and client-side fallbacks should revalidate.
		@document not path /york-chiller/assets/* /york-chiller/models/* /york-chiller/icon.svg
		header @document Cache-Control "no-cache"

		# gzip text, JS, CSS, and SVG. GLB stays uncompressed (binary, unhashed).
		encode gzip
		try_files {path} /york-chiller/index.html
		file_server
	}

	handle {
		root * dist
		encode gzip
		file_server
		try_files {path} /index.html
	}
}
